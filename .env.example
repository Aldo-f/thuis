# VRT MAX credentials (used by thuis downloader)
# Copy to .env and fill in your credentials
VRT_EMAIL=your-email@example.com
VRT_PASSWORD=your-password

# Default output directory for downloaded episodes
# Can also set this here instead of using --output-dir each time
# OUTPUT_DIR=/path/to/your/downloads
OUTPUT_DIR=media

# DRM decryption policy (default: yes)
# Set to "no" to skip DRM-protected content instead of attempting decryption
# Accepted values: yes|1|true (enable), anything else (disable)
DECRYPT_DRM=yes

# Path to WVD (Widevine CDM) cache directory for DRM decryption
# Required when DECRYPT_DRM=yes and content uses Widevine DRM
# WVD_CDM_PATH=/path/to/cache
