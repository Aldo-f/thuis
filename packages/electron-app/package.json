{
  "name": "@thuis/electron-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "Thuis-V2 desktop application for VRT MAX episode management",
  "homepage": "https://Aldo-f.github.io/thuis/",
  "author": {
    "name": "Aldo Fieuw",
    "email": "aldo.fieuw@gmail.com"
  },
  "scripts": {
    "dev": "electron .",
    "build": "tsc -p . && electron-builder --publish never",
    "build:dir": "tsc -p . && electron-builder --publish never --dir",
    "lint": "eslint . --ext .ts,.tsx",
    "postinstall": "electron-builder install-app-deps",
    "build:android": "pnpm --filter @thuis/electron-app run electron-builder -p android"
  },
  "dependencies": {
    "@thuis/core": "workspace:*",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.6.2",
    "@types/node": "^20.14.0"
  }
}
