{
  "name": "thuis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @thuis/core build",
    "build:web": "pnpm --filter @thuis/web-app build",
    "build:electron": "pnpm --filter @thuis/electron-app build",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @thuis/core test",
    "lint": "pnpm -r lint",
    "lint:core": "pnpm --filter @thuis/core lint"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1"
  }
}
