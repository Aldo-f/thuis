output_dir: media
watchlist_dir: watchlists
log_dir: logs
database_path: data/watchlist.db
drm:
  enabled: false
  cdm_path: ''
  decrypt_policy: 'no'
ytdlp:
  default_profile: best
  resolutions:
  - 720
  - 1080
  - 1440
  - 2160
  extra_args: []
network:
  metadata_timeout: 30
  download_timeout: 3600
logging:
  level: INFO
  format: text
plugins:
  enabled:
  - torrent_uploader
  torrent_uploader:
    piece_size: 262144
    comment: ''
    source: thuis
